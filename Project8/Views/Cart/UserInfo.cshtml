@model WebBanSach.Models.Data.KhachHang
@if(Model!=null){
<h3>Thông tin nhận hàng</h3><p>@Model.TenKH — @Model.DienThoai</p><p>@Model.DiaChi</p>
<p><a href="@Url.Action("EditUser","User")">Sửa họ tên / địa chỉ trước khi đặt hàng</a></p>
using(Html.BeginForm("Payment","Cart",FormMethod.Post)) {
@Html.AntiForgeryToken()<input type="hidden" name="PaymentMethod" value="1"/>
<p>Thanh toán khi nhận hàng (COD). Giá được kiểm tra lại khi xác nhận.</p>
<button type="submit" class="btn btn-success">Xác nhận đặt hàng</button>
}}